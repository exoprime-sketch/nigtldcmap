      "direction": "higher-better",
      "directionLabel": "점수가 높을수록 공공부문이 더 청렴하게 인식됨",
      "officialBands": null,
      "benchmarkType": "group-rank",
      "benchmarkScope": "동일 연도 조사 대상국"
    },
    {
